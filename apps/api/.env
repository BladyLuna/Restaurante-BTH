# Configuración de desarrollo. No usar estos valores en el local real.
# Copiar a .env y ajustar.

DATABASE_URL="postgresql://restaurante:restaurante_dev@localhost:5434/restaurante?schema=public"

# Clave de firma de los JWT. En el local real debe ser un valor aleatorio largo.
JWT_SECRET="desarrollo-cambiar-en-produccion"

# Duración de la sesión. El de cocina dura la jornada; el de admin/caja menos
# porque autoriza movimientos de dinero (PLAN 6).
JWT_EXPIRES_COCINA="12h"
JWT_EXPIRES_ADMIN="4h"

# Puerto de la API
PORT=3000

# Carpeta donde se guardan fotos de platos, QR y comprobantes.
# ImageStorage es una interfaz (ARQUITECTURA 4): disco local hoy, otra cosa
# mañana sin tocar el resto.
UPLOADS_DIR="./uploads"

# Habilita los origenes CORS de desarrollo (Expo en 8081). Ver src/cors.ts.
NODE_ENV="development"
# Origenes extra permitidos, exactos y separados por coma.
CORS_ORIGINS="http://localhost:19006,http://localhost:8081"
